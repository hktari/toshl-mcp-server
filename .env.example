# Toshl API Configuration
TOSHL_API_TOKEN=your_toshl_api_token_here
TOSHL_API_BASE_URL=https://api.toshl.com

# MCP Server Configuration
MCP_SERVER_NAME=toshl-mcp-server
MCP_SERVER_VERSION=0.1.0

# Caching Configuration
CACHE_TTL=3600  # Time to live in seconds
CACHE_ENABLED=true

# Logging Configuration
LOG_LEVEL=info

# Transport: stdio (default) or http. See "Remote use (Streamable HTTP)" in README.md.
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
# MCP_AUTH_TOKEN=     # required in http mode; at least 32 characters, e.g. `openssl rand -hex 32`
# MCP_ALLOWED_HOSTS=  # the reverse proxy's public hostname
# MCP_ALLOWED_ORIGINS=  # browser origins allowed to call /mcp; empty refuses every Origin
# MCP_ALLOW_NO_AUTH=true  # only behind a proxy that authenticates every request

# Built-in OAuth server (claude.ai connectors). On when the passphrase and signing key are set.
# See "Sign-in with OAuth" in README.md.
# MCP_PUBLIC_URL=https://example.com  # public origin, no path; the MCP URL is <this>/mcp
# MCP_OAUTH_PASSPHRASE=               # typed on the sign-in page; at least 20 characters
# MCP_OAUTH_SIGNING_KEY=              # at least 32 characters, e.g. `openssl rand -hex 32`
# MCP_OAUTH_SIGNING_KEY_PREVIOUS=     # old key, still accepted while rotating
# MCP_OAUTH_STATE_DIR=./state         # refresh-token hashes; keep it across restarts
# MCP_TRUST_PROXY=true                # client IP from X-Forwarded-For, only behind your proxy
