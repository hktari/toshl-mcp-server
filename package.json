{
    "name": "toshl-mcp-server",
    "version": "0.1.0",
    "description": "MCP server for Toshl Finance API integration",
    "main": "dist/src/index.js",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "postbuild": "test -f dist/src/index.js && chmod +x dist/src/index.js || true",
        "start": "node dist/src/index.js",
        "dev": "ts-node --esm src/index.ts",
        "test": "jest",
        "test:env": "node -r dotenv/config node_modules/.bin/jest dotenv_config_path=.env.test",
        "lint": "eslint src/**/*.ts",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "keywords": [
        "toshl",
        "finance",
        "mcp",
        "server",
        "ai"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.31.0",
        "axios": "^1.20.0",
        "dotenv": "^16.6.1",
        "node-cache": "^5.1.2",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.4",
        "@typescript-eslint/eslint-plugin": "^8.71.1",
        "@typescript-eslint/parser": "^8.71.1",
        "eslint": "^10.12.0",
        "jest": "^30.5.2",
        "prettier": "^3.9.9",
        "ts-jest": "^29.4.14",
        "ts-node": "^10.9.1",
        "typescript": "^5.9.3"
    }
}
